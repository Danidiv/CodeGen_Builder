# Copy this file to .env.local and fill in what you use.
# NEVER commit .env.local or share it. It holds your secret keys.

# --- Supabase (login + saving projects in the cloud) ---
# Dashboard -> Project Settings -> API.
# Use ONLY the public "anon" / "publishable" key here. NEVER the service_role / secret key.
# Leave both empty to run without login (project is then saved in this browser only).
NEXT_PUBLIC_SUPABASE_URL=https://gtgxzcrrbbcltihxyddz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key_here

# Which AI to use: "anthropic" (Claude API), "openrouter", or "lmstudio" (local model)
LLM_PROVIDER=openrouter

# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Key from https://openrouter.ai/keys  (starts with sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_key_here
# Any model slug from https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Max output tokens per request (lower = cheaper, 8000 is enough for most pages)
OPENROUTER_MAX_TOKENS=8000

# --- Claude API directly (LLM_PROVIDER=anthropic) ---
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- LM Studio (LLM_PROVIDER=lmstudio) ---
# In LM Studio: Developer tab -> load a model -> Start Server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Exact model name shown in LM Studio (e.g. qwen2.5-coder-14b-instruct)
LMSTUDIO_MODEL=local-model
# Qwen3-style models "think" for minutes before answering. Set to true to add
# "/no_think" to every request (works for models that support that switch).
LMSTUDIO_NO_THINK=true

# --- Usage limit (cloud mode only) ---
# AI requests per user per day. 0 = unlimited. Default 30.
# Every request that reaches the AI counts, including automatic retries and auto-fixes.
DAILY_LIMIT=30

# --- Prompt size ---
# Local models (LM Studio) automatically get a shorter prompt with a size limit.
# Force it with PROMPT_MODE=compact, or force the full one with PROMPT_MODE=full.
# PROMPT_MODE=
