# Copy this file to .env.local and fill in what you use.
# NEVER commit .env.local or share it. It holds your secret keys.

# --- Supabase (login + saving projects in the cloud) ---
# Dashboard -> Project Settings -> API.
# Use ONLY the public "anon" / "publishable" key here. NEVER the service_role / secret key.
# Leave both empty to run without login (project is then saved in this browser only).
NEXT_PUBLIC_SUPABASE_URL=https://gtgxzcrrbbcltihxyddz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_y3EMDtc28aqCVFxlRpkhxg_LRA9UW0w

# Which AI to use: "anthropic" (Claude API), "openrouter", or "lmstudio" (local model)

LLM_PROVIDER=openrouter

# LLM_PROVIDER=lmstudio
DAILY_LIMIT=60


# --- OpenRouter (LLM_PROVIDER=openrouter) ---
# Key from https://openrouter.ai/keys  (starts with sk-or-v1-...)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Any model slug from https://openrouter.ai/modelsnpm 
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
# Max output tokens per request (lower = cheaper, 80000 is enough for most pages)
OPENROUTER_MAX_TOKENS=80000

# --- Claude API directly (LLM_PROVIDER=anthropic) ---
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- LM Studio (LLM_PROVIDER=lmstudio) ---
# In LM Studio: Developer tab -> load a model -> Start Server
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Exact model name shown in LM Studio (e.g. qwen2.5-coder-14b-instruct)
LMSTUDIO_MODEL=qwen3.5-9b



# --- Photos (optional but recommended) ---
# Free key from https://www.pexels.com/api/ . Without it, sites get neutral placeholder photos.
# The AI writes photo keywords (image:espresso coffee cup) and the app replaces them with real, matching photos.
PEXELS_API_KEY=
# Optional second source. Unsplash "Access Key" from https://unsplash.com/developers (new app).
# Demo mode allows only 50 requests per hour; apply for production in the Unsplash dashboard before real use.
UNSPLASH_ACCESS_KEY=
# Order to try (default "pexels,unsplash"; only providers with a key are used).
# IMAGE_PROVIDERS=pexels,unsplash
# Unsplash requires reporting each used photo to its download endpoint. Keep this on unless you know better.
# UNSPLASH_TRACK_DOWNLOADS=true





